# Rakuten Web Service
RAKUTEN_APP_ID=your_application_id
RAKUTEN_ACCESS_KEY=your_access_key
RAKUTEN_AFFILIATE_ID=
RAKUTEN_MIN_INTERVAL=0.8

# Supabase - server side only
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=your_secret_key
# Legacy fallback if you have not migrated keys yet:
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: pin another documented Ichiba Item Search API version later.
RAKUTEN_ICHIBA_ITEM_API_URL=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260401
